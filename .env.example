# Application URL opened in the browser; must match OAuth callback registrations.
APP_ORIGIN=http://localhost:3000
# Used by compose.vm.yaml and Caddy. Set APP_ORIGIN=https://this-host on a VM.
APP_DOMAIN=portfolio.example.com

# Generated by scripts/setup.py. Keep this key with database backups.
ENCRYPTION_KEY=
POSTGRES_PASSWORD=

# Optional for native development. Default: sqlite:///absolute/project/path/contour.db
# DATABASE_URL=postgresql+psycopg://contour:password@127.0.0.1:5432/contour

ALLOW_REGISTRATION=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=

BSC_RPC_URLS=https://bsc-dataseed.bnbchain.org,https://bsc-dataseed-public.bnbchain.org
COINGECKO_DEMO_API_KEY=
MORALIS_API_KEY=

# Native/local Docker API only. VM Compose trusts its fixed Caddy IP instead.
FORWARDED_ALLOW_IPS=127.0.0.1

# Optional server-owned EVM RPC overrides (comma-separated, up to 3 fallbacks).
ETHEREUM_RPC_URLS=https://ethereum-rpc.publicnode.com
ARBITRUM_RPC_URLS=https://arbitrum-one-rpc.publicnode.com,https://arb1.arbitrum.io/rpc
OPTIMISM_RPC_URLS=https://optimism-rpc.publicnode.com
BASE_RPC_URLS=https://base-rpc.publicnode.com
